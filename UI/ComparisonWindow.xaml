<Window x:Class="BimComparison.UI.ComparisonWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="BIM Model Comparison — Phase 3" Width="1220" Height="900" MinWidth="900" MinHeight="740" WindowStartupLocation="CenterOwner">
 <DockPanel Margin="14">
  <TextBlock DockPanel.Dock="Bottom" Text="{Binding Status}" Margin="0,8,0,0"/>
  <StackPanel DockPanel.Dock="Top" x:Name="ControlsPanel">
   <TextBlock Text="Model A (old RVT or JSON)"/>
   <DockPanel Margin="0,4"><Button DockPanel.Dock="Right" Content="Browse A" Click="BrowseA" Width="100"/><TextBox Text="{Binding ModelA,UpdateSourceTrigger=PropertyChanged}"/></DockPanel>
   <TextBlock Text="Model B (JSON for JSON workflow; RVT workflow always uses active project)"/>
   <DockPanel Margin="0,4"><Button DockPanel.Dock="Right" Content="Browse B" Click="BrowseB" Width="100"/><TextBox Text="{Binding ModelB,UpdateSourceTrigger=PropertyChanged}"/></DockPanel>
   <Expander Header="Categories and comparison settings" IsExpanded="True" Margin="0,6">
    <StackPanel>
     <ItemsControl ItemsSource="{Binding Categories}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><CheckBox Content="{Binding Name}" IsChecked="{Binding Selected}" Margin="0,4,14,4"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
     <WrapPanel Margin="0,5">
      <CheckBox Content="Parameters (instance + type)" IsChecked="{Binding CompareParameters}" Margin="0,0,16,0"/><CheckBox Content="Location" IsChecked="{Binding CompareLocation}" Margin="0,0,16,0"/>
      <TextBlock Text="Length tolerance (mm): "/><TextBox Text="{Binding LengthMm}" Width="65" Margin="0,0,12,0"/>
      <TextBlock Text="Other numbers (internal): "/><TextBox Text="{Binding NumberTolerance}" Width="95" Margin="0,0,12,0"/>
      <TextBlock Text="Angle (rad): "/><TextBox Text="{Binding AngleTolerance}" Width="85"/>
     </WrapPanel>
     <WrapPanel Margin="0,5">
      <CheckBox Content="Geometry" IsChecked="{Binding CompareGeometry}" Margin="0,0,12,0"/>
      <ComboBox ItemsSource="{Binding GeometryModes}" SelectedItem="{Binding GeometryMode}" Width="110" Margin="0,0,16,0"/>
      <CheckBox Content="MEP systems / dimensions" IsChecked="{Binding CompareMep}" Margin="0,0,16,0"/>
      <CheckBox Content="Connectors" IsChecked="{Binding CompareConnectors}" Margin="0,0,16,0"/>
      <TextBlock Text="Area tolerance (ft²): "/><TextBox Text="{Binding AreaTolerance}" Width="85" Margin="0,0,12,0"/>
      <TextBlock Text="Volume (ft³): "/><TextBox Text="{Binding VolumeTolerance}" Width="85"/>
     </WrapPanel>
     <TextBlock Text="Old Phase 1 JSON: turn off Geometry, MEP and Connectors. Export both models again to compare Phase 2." Foreground="DimGray" TextWrapping="Wrap"/>
    </StackPanel>
   </Expander>
   <WrapPanel Margin="0,4,0,8">
    <Button Content="Export active model JSON" Click="ExportJson" Padding="10,5" Margin="0,0,8,0"/>
    <Button Content="Compare A RVT → active B" Click="CompareRvt" Padding="10,5" Margin="0,0,8,0"/>
    <Button Content="Compare A/B JSON" Click="CompareJson" Padding="10,5" Margin="0,0,8,0"/>
    <Button Content="Export report" Click="ExportReport" Padding="10,5" Margin="0,0,8,0"/>
    <Button Content="Select element" Click="SelectElement" Padding="10,5" Margin="0,0,8,0"/>
    <Button Content="Zoom to element" Click="ZoomElement" Padding="10,5"/>
   </WrapPanel>
   <WrapPanel Margin="0,0,0,8">
    <Button Content="Highlight all changes" Click="HighlightAll" Padding="10,5" Margin="0,0,8,0"/>
    <Button Content="Highlight selected element" Click="HighlightSelected" Padding="10,5" Margin="0,0,8,0"/>
    <Button Content="Clear Highlights (active view)" Click="ClearHighlights" Padding="10,5" Margin="0,0,12,0"/>
    <Button Content="Close and inspect view" Click="InspectView" Padding="10,5" Margin="0,0,12,0"/>
    <CheckBox Content="Classify modified colors" IsChecked="{Binding ClassifyHighlightColors}" VerticalAlignment="Center"/>
   </WrapPanel>
   <TextBlock Text="Added: green | Modified: yellow | Classified: geometry orange, location blue, system purple | Deleted: report only" Foreground="DimGray" TextWrapping="Wrap" Margin="0,0,0,6"/>
  </StackPanel>
  <Button DockPanel.Dock="Bottom" x:Name="CancelButton" Content="Cancel JSON comparison" Click="Cancel" IsEnabled="False" HorizontalAlignment="Left" Margin="0,6"/>
  <Expander DockPanel.Dock="Bottom" Header="Warnings / extraction errors" Margin="0,6"><TextBox Text="{Binding Warnings}" IsReadOnly="True" MaxHeight="130" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"/></Expander>
  <StackPanel DockPanel.Dock="Top">
   <TextBlock Text="{Binding Summary}" FontWeight="Bold" Margin="0,6"/>
   <DockPanel Margin="0,6"><ComboBox DockPanel.Dock="Right" ItemsSource="{Binding Filters}" SelectedItem="{Binding Filter}" Width="130"/><TextBlock DockPanel.Dock="Left" Text="Search: " VerticalAlignment="Center"/><TextBox Text="{Binding Search,UpdateSourceTrigger=PropertyChanged}"/></DockPanel>
  </StackPanel>
  <DataGrid x:Name="Results" ItemsSource="{Binding RowsView}" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" EnableRowVirtualization="True" EnableColumnVirtualization="True" CanUserAddRows="False">
   <DataGrid.Columns>
    <DataGridTextColumn Header="Status" Binding="{Binding Status}"/><DataGridTextColumn Header="ElementId" Binding="{Binding ElementId}"/>
    <DataGridTextColumn Header="UniqueId" Binding="{Binding UniqueId}" Width="180"/><DataGridTextColumn Header="Category" Binding="{Binding Category}"/>
    <DataGridTextColumn Header="Family" Binding="{Binding Family}"/><DataGridTextColumn Header="Type" Binding="{Binding Type}"/>
    <DataGridTextColumn Header="Change type" Binding="{Binding ChangeType}"/><DataGridTextColumn Header="Property" Binding="{Binding Property}" Width="200"/>
    <DataGridTextColumn Header="Old value" Binding="{Binding OldValue}" Width="150"/><DataGridTextColumn Header="New value" Binding="{Binding NewValue}" Width="150"/>
   </DataGrid.Columns>
  </DataGrid>
 </DockPanel>
</Window>
