<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
 <PropertyGroup>
  <TargetFramework>net48</TargetFramework><UseWPF>true</UseWPF><OutputType>Library</OutputType><PlatformTarget>x64</PlatformTarget><LangVersion>7.3</LangVersion><GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  <RevitInstallDir Condition="'$(RevitInstallDir)' == ''">C:\Program Files\Autodesk\Revit 2023</RevitInstallDir>
  <EnableDefaultCompileItems>false</EnableDefaultCompileItems><EnableDefaultPageItems>false</EnableDefaultPageItems>
 </PropertyGroup>
 <ItemGroup>
  <Compile Include="App.cs;Commands\*.cs;Core\*.cs;Extraction\*.cs;Visualization\*.cs;UI\*.cs;Properties\AssemblyInfo.cs"/><Page Include="UI\ComparisonWindow.xaml"/>
  <Reference Include="RevitAPI"><HintPath>$(RevitInstallDir)\RevitAPI.dll</HintPath><Private>false</Private></Reference>
  <Reference Include="RevitAPIUI"><HintPath>$(RevitInstallDir)\RevitAPIUI.dll</HintPath><Private>false</Private></Reference>
  <Reference Include="Newtonsoft.Json"><HintPath>$(RevitInstallDir)\Newtonsoft.Json.dll</HintPath><Private>false</Private></Reference>
 </ItemGroup>
</Project>
